# ==========================================
# FUTRSEC AI RESUME ENGINE - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and supply your credentials.
# NEVER commit .env to version control.

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://<user>:<password>@<neon-host>.neon.tech/<dbname>?sslmode=require

# Application Settings
ENVIRONMENT=development
DEBUG=false
SCORE_THRESHOLD=80.0
MAX_UPLOAD_SIZE_MB=10

# Database Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_SEC=10.0

# ==========================================
# AI Model 1 — Resume Analysis (Google Gemini API)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SEC=60.0

# ==========================================
# AI Model 2 — Resume Creation (GroqCloud)
# ==========================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SEC=60.0

# CORS Allowed Origins (Comma-separated or JSON list in FastAPI)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
